<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>UnityRuntimeDebugger.Core.Tests</AssemblyName>
    <RootNamespace>UnityRuntimeDebugger.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Core/Core.csproj" />
    <!-- Integration tests run the fake game as its own process; this only makes sure it is built. -->
    <ProjectReference Include="../FakeGame/FakeGame.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>FakeGame</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)../FakeGame/bin/$(Configuration)/net10.0/Assembly-CSharp.dll</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
